{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "expr": "xray_zig_ready", "refId": "A" } ],
      "title": "Ready",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "expr": "xray_zig_uptime_seconds", "refId": "A" } ],
      "title": "Uptime",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "expr": "sum(xray_zig_connections_active)", "refId": "A" } ],
      "title": "Active connections",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "expr": "sum(xray_zig_bpf_offloaded_flows{network=\"tcp\"})", "refId": "A" } ],
      "title": "SOCKHASH flows",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "expr": "xray_zig_raw_reactor_connections / clamp_min(xray_zig_raw_reactor_limit, 1)", "refId": "A" } ],
      "title": "Raw capacity",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "expr": "sum(rate(xray_zig_bytes_total[5m])) + sum(rate(xray_zig_bpf_sockhash_bytes_total[5m]))", "refId": "A" } ],
      "title": "Total throughput",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "id": 7,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "sum by (result) (rate(xray_zig_connections_total{inbound=\"all\",outbound=\"all\"}[5m]))", "legendFormat": "{{result}}", "refId": "A" } ],
      "title": "Connection rate",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "id": 8,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (direction, path) (rate(xray_zig_bytes_total[5m]))", "legendFormat": "{{direction}} / {{path}}", "refId": "A" },
        { "expr": "sum by (direction, owner) (rate(xray_zig_bpf_sockhash_bytes_total[5m]))", "legendFormat": "{{direction}} / sockhash {{owner}}", "refId": "B" }
      ],
      "title": "Traffic paths",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "id": 9,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "sum by (outbound, rule) (rate(xray_zig_routing_decisions_total[5m]))", "legendFormat": "{{outbound}} / {{rule}}", "refId": "A" } ],
      "title": "Routing decisions",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "id": 10,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "sum by (qtype, result) (rate(xray_zig_dns_queries_total{resolver=\"all\"}[5m]))", "legendFormat": "{{qtype}} / {{result}}", "refId": "A" } ],
      "title": "DNS outcomes",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "id": 11,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "sum by (stage, result) (rate(xray_zig_reality_handshakes_total[5m]))", "legendFormat": "{{stage}} / {{result}}", "refId": "A" } ],
      "title": "REALITY stages",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "id": 12,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (transition, result) (rate(xray_zig_vision_transitions_total[5m]))", "legendFormat": "Vision {{transition}} / {{result}}", "refId": "A" },
        { "expr": "sum by (owner, result) (rate(xray_zig_bpf_offload_total{network=\"tcp\"}[5m]))", "legendFormat": "Offload {{owner}} / {{result}}", "refId": "B" }
      ],
      "title": "Vision eligibility and offload",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 20 },
      "id": 13,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "xray_zig_bpf_program_up", "legendFormat": "{{hook}}", "refId": "A" } ],
      "title": "BPF hooks",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 20 },
      "id": 14,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "xray_zig_bpf_map_entries / on(map) clamp_min(xray_zig_bpf_map_capacity, 1)", "legendFormat": "{{map}}", "refId": "A" } ],
      "title": "BPF map utilization",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 20 },
      "id": 15,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "increase(xray_zig_bpf_sockhash_redirect_errors_total[5m])", "legendFormat": "redirect errors", "refId": "A" },
        { "expr": "increase(xray_zig_connection_rejections_total[5m])", "legendFormat": "capacity rejections", "refId": "B" }
      ],
      "title": "Correctness signals",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [ "xray-zig", "openwrt", "ebpf" ],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "xray-zig Overview",
  "uid": "xray-zig-overview",
  "version": 1,
  "weekStart": ""
}
